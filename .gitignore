# --- Data: DVC tracks the bytes, git tracks only the .dvc pointers ---
# Deliberately NOT a blanket `/data/` ignore. That would hide data/*.dvc as
# well, and those files are the whole point: they carry the content hash
# that ties a model to the exact bytes it was trained on. DVC writes its own
# data/.gitignore for the tracked directories; the extension patterns below
# and in the Python section are the safety net if it ever does not.
/data/**/*.parquet
/data/**/*.csv
/data/**/*.csv.gz
/data/**/*.zip

# --- Model artifacts and reports (never in git) ---
# Leading slash anchors these to the repo root. Without it, `models/` would
# also match any nested directory of that name.
/models/
/reports/
*.parquet
*.csv
*.csv.gz
*.zip
*.pkl
*.joblib

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# --- Testing / coverage ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# --- Notebooks ---
.ipynb_checkpoints/

# --- MLflow (local tracking store) ---
# mlflow.db is the SQLite backend; mlartifacts/ holds the logged model
# binaries it points at. Both are run records, not source.
mlflow.db
mlflow.db-journal
mlruns/
mlartifacts/

# --- Secrets & local config ---
.env
.env.*
!.env.example
kaggle.json
*.pem

# --- Editors / OS ---
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
